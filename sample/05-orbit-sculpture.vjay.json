    {"id": 0,"kind": "Comment","parameters": [],"settings": {"preview": false,"port_version": 0,"label": "05 / ORBIT SCULPTURE","comment": "回転は2つのLFO。\nShapeで形を変更。\nTextureで表面の模様を調整。"}},
    {"id": 1,"kind": "GLSL","parameters": [0.4,7,0.055,0.48,1],"settings": {"preview": false,"port_version": 0,"label": "STAR FIELD","shader": "\nvec3 palette(float t) {\n    return 0.5 + 0.5*cos(6.2831853*(t+vec3(0.0,0.33,0.67)));\n}\nmat2 turn(float a) {return mat2(cos(a),-sin(a),sin(a),cos(a));}\n\nfloat hash(vec2 p){return fract(sin(dot(p,vec2(113.1,311.7)))*43758.5453);}\nvoid mainImage(out vec4 color,in vec2 pixel) {\n vec2 uv=pixel/iResolution.xy;\n vec2 p=(pixel*2.0-iResolution.xy)/iResolution.y;\n float t=iTime*rate;\n vec3 rgb=vec3(0.004,0.006,0.015);\n for(int k=0;k<3;k++) {\n  float layer=float(k)+1.0;\n  vec2 q=p*(density+float(k)*5.0)+vec2(t*layer*0.12,t*layer*0.05);\n  vec2 id=floor(q),cell=fract(q)-0.5;\n  vec2 shift=vec2(hash(id),hash(id+vec2(9.2)))-0.5;\n  float d=length(cell-shift*0.7);\n  float star=exp(-d*d/(size*size));\n  rgb+=palette(hue+hash(id)*0.25)*star*(0.5+0.5*sin(t+hash(id)*6.0))/layer;\n }\n rgb+=vec3(0.01,0.03,0.06)*exp(-length(p)*0.6);\n color=vec4(rgb*gain,1.0);\n}\n","shader_uniforms": [{"name": "rate","min": 0,"max": 3,"default": 0.4},{"name": "density","min": 3,"max": 20,"default": 7},{"name": "size","min": 0.015,"max": 0.15,"default": 0.055},{"name": "hue","min": 0,"max": 1,"default": 0.48},{"name": "gain","min": 0,"max": 2,"default": 1}]}},
