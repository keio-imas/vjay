    {"id": 1,"kind": "GLSL","parameters": [0.55,1.7,3.8,3.5,0.18,0.25],"settings": {"preview": true,"port_version": 0,"label": "SHARED LIQUID","shader": "vec3 palette(float t){return 0.5+0.5*cos(6.2831853*(t+vec3(0.0,0.33,0.67)));}\nvoid mainImage(out vec4 color,in vec2 pixel) {\n // Integer spatial frequencies make both texture edges join in the tunnel.\n vec2 p=pixel/iResolution.xy*6.2831853*floor(scale+0.5);\n float t=iTime*rate;\n vec2 q=vec2(sin(p.x+cos(p.y+t*0.13)),cos(p.y+sin(p.x-t*0.17)));\n float f=sin(p.x*2.0+warp*q.y+t*0.12)+cos(p.y*2.0+warp*q.x-t*0.09);\n float band=0.5+0.5*sin(f*detail+t*0.2);\n vec3 rgb=palette(hue+band*0.45)*(0.08+0.92*pow(band,1.7));\n rgb+=pow(1.0-abs(band*2.0-1.0),14.0)*shine*vec3(0.4,0.7,0.8);\n color=vec4(rgb,1.0);\n}\n","shader_uniforms": [{"name": "rate","min": 0,"max": 3,"default": 0.55},{"name": "scale","min": 0.5,"max": 4,"default": 1.7},{"name": "warp","min": 0,"max": 8,"default": 3.8},{"name": "detail","min": 1,"max": 8,"default": 3.5},{"name": "hue","min": 0,"max": 1,"default": 0.18},{"name": "shine","min": 0,"max": 1,"default": 0.25}]}},
