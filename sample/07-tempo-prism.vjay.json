    {"id": 0,"kind": "Comment","parameters": [],"settings": {"preview": false,"port_version": 0,"label": "07 / TEMPO PRISM","comment": "BPMに合わせて回転。\nHITでも起動できます。\nReleaseで戻る時間を調整。"}},
    {"id": 1,"kind": "GLSL","parameters": [0.8,5,0.025,0.2,0.7],"settings": {"preview": true,"port_version": 0,"label": "LASER FLOWER","shader": "\nvec3 palette(float t) {\n    return 0.5 + 0.5*cos(6.2831853*(t+vec3(0.0,0.33,0.67)));\n}\nmat2 turn(float a) {return mat2(cos(a),-sin(a),sin(a),cos(a));}\n\nvoid mainImage(out vec4 color,in vec2 pixel) {\n vec2 p=(pixel*2.0-iResolution.xy)/iResolution.y;\n p=turn(iTime*rate*0.1)*p;\n float t=iTime*rate;\n float a=atan(p.y,p.x),r=length(p);\n float ring=0.55+sin(a*petals+t)*0.12+sin(a*3.0-t*0.7)*0.08;\n float d=abs(r-ring);\n vec3 rgb=palette(hue+a*0.08)*exp(-d*d/(width*width));\n rgb+=palette(hue+0.2)*exp(-d*12.0)*glow*0.22;\n float spokes=pow(0.5+0.5*cos(a*petals*2.0+t),24.0);\n rgb+=palette(hue+0.4)*spokes*exp(-abs(r-0.85)*18.0)*0.5;\n color=vec4(rgb,1.0);\n}\n","shader_uniforms": [{"name": "rate","min": 0,"max": 3,"default": 0.8},{"name": "petals","min": 2,"max": 12,"default": 5},{"name": "width","min": 0.01,"max": 0.12,"default": 0.025},{"name": "hue","min": 0,"max": 1,"default": 0.2},{"name": "glow","min": 0,"max": 2,"default": 0.7}]}},
