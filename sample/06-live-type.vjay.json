    {"id": 1,"kind": "GLSL","parameters": [0.65,1,0.095,0.025,0.8,0.7],"settings": {"preview": false,"port_version": 0,"label": "RIBBON BACKGROUND","shader": "\nvec3 palette(float t) {\n    return 0.5 + 0.5*cos(6.2831853*(t+vec3(0.0,0.33,0.67)));\n}\nmat2 turn(float a) {return mat2(cos(a),-sin(a),sin(a),cos(a));}\n\nvoid mainImage(out vec4 color,in vec2 pixel) {\n vec2 p=(pixel*2.0-iResolution.xy)/iResolution.y/zoom;\n float t=iTime*rate;\n vec3 rgb=vec3(0.006,0.008,0.025);\n for(int k=0;k<9;k++) {\n  float f=float(k);\n  float y=sin(p.x*1.7+t*0.6+f*0.35)*0.38+sin(p.x*0.75-t*0.24+f)*0.18+(f-4.0)*spacing;\n  float d=abs(p.y-y);\n  vec3 ink=palette(hue+f*0.065+p.x*0.05);\n  rgb+=ink*(exp(-d*d/(width*width))*0.7+exp(-d*16.0)*glow*0.14);\n }\n color=vec4(rgb,1.0);\n}\n","shader_uniforms": [{"name": "rate","min": 0,"max": 3,"default": 0.65},{"name": "zoom","min": 0.4,"max": 2,"default": 1},{"name": "spacing","min": 0.04,"max": 0.2,"default": 0.095},{"name": "width","min": 0.008,"max": 0.08,"default": 0.025},{"name": "hue","min": 0,"max": 1,"default": 0.8},{"name": "glow","min": 0,"max": 2,"default": 0.7}]}},
